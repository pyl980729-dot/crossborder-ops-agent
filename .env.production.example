# ===========================================================================
# 生产环境配置模板
#
# 使用方法：
#   1. 复制本文件为 .env（与项目根目录同级）
#   2. 逐项填写，带「必填」标记的不能留空
#   3. 重启服务生效（python run.py 或 docker compose up -d）
#
# 注意：.env 含密钥，不要提交到代码仓库，也不要放进交付包。
# ===========================================================================

# ---------------------------------------------------------------------------
# 一、安全（对外提供服务时必填）
# ---------------------------------------------------------------------------

# 强制登录：开启后，即使库里还没有用户，除「初始化」「登录」外的接口一律返回 401。
# 首次部署流程：开启 → 打开页面 → 创建负责人账号 → 正常使用。
# 关闭时系统为「开放模式」：无用户情况下匿名访问被视为负责人，仅适合本机演示。
ECOM_REQUIRE_LOGIN=1

# 服务令牌：供脚本、定时任务、监控探针调用 API 使用。
# 设置后可用请求头 X-API-Token 或 Authorization: Bearer <token> 访问。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 若所有调用都来自浏览器且已启用强制登录，可留空。
ECOM_API_TOKEN=

# 允许的跨域来源，多个用逗号分隔。**生产环境不要留空**（留空等于允许所有来源）。
# 例如：ECOM_CORS_ORIGINS=https://ops.your-domain.com
ECOM_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 二、运行
# ---------------------------------------------------------------------------

# 日志级别：DEBUG / INFO / WARNING
ECOM_LOG_LEVEL=INFO

# 内置调度器（定时任务）。off 可关闭，用于多副本部署或纯手工触发场景。
# 注意：调度器按单进程设计，多副本部署会重复触发，必须只保留一个实例。
ECOM_SCHEDULER=on

# ---------------------------------------------------------------------------
# 三、大模型（可选）
#
# 不配置 = 离线规则模式，全链路仍然完整可用，只是标题/口播稿为模板文案。
# 只有创意类产出会调用模型；定价、广告分级、评论归因永远走确定性脚本。
# ---------------------------------------------------------------------------

ECOM_LLM_PROVIDER=rule

# 阿里云百炼（国内网络直连，推荐）
# ECOM_LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# ECOM_LLM_MODEL=qwen-plus

# DeepSeek
# ECOM_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# ECOM_LLM_MODEL=deepseek-chat

# 任意 OpenAI 兼容端点（自建 vLLM / 其他云厂商）
# ECOM_LLM_PROVIDER=openai
# ECOM_LLM_BASE_URL=https://your-endpoint/v1
# ECOM_LLM_API_KEY=
# ECOM_LLM_MODEL=your-model
