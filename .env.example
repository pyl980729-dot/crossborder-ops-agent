# ===========================================================================
# LLM 配置（可选）。不配置时系统跑「离线规则模式」，全链路依然完整可用。
#
# 重要：只有创意类产出（标题、口播稿）会调用模型。
#       分析类结论（定价、广告分级、评论归因）永远走确定性脚本，不交给模型。
#
# 改完这个文件后需要重启服务（python run.py）才生效。
# ===========================================================================

# 阿里云百炼（DashScope）—— 推荐，国内网络直连
ECOM_LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# 可用模型：qwen-plus（默认，性价比） / qwen-max（效果最好） / qwen-turbo（最快）
ECOM_LLM_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# 其他供应商（任选其一，把上面几行注释掉再启用）
# ---------------------------------------------------------------------------
# DeepSeek
# ECOM_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxx

# OpenAI
# ECOM_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# ECOM_LLM_MODEL=gpt-4o-mini

# 任意 OpenAI 兼容端点（自建 vLLM、其他云厂商）
# ECOM_LLM_PROVIDER=openai
# ECOM_LLM_BASE_URL=https://your-endpoint/v1
# ECOM_LLM_API_KEY=sk-xxxx
# ECOM_LLM_MODEL=your-model

# 强制离线（即使配了 key 也不用）
# ECOM_LLM_PROVIDER=rule
